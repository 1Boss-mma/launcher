                                            VerticalAlignment="Center">
                                    <controls:PixelButton x:Name="WorldsFolderButton"
                                                          Content="ПАПКА SAVES" Variant="Secondary"
                                                          IconKind="Folder" Height="34"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Click="OpenSavesFolder_Click"/>
