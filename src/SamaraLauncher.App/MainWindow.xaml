                                <Border Grid.Column="0"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="2">
                                    <StackPanel Margin="14,12">
                                        <TextBlock Text="СЕРВЕР"
                                                   Style="{StaticResource Caps}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Папка установки, порт и память Java"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11"
                                                   Margin="0,2,0,10"/>

                                        <TextBlock Text="ПАПКА СЕРВЕРА"
                                                   Style="{StaticResource Caps}"
                                                   FontSize="9"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="HostDirBox"
