                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,22,0,0"><RadioButton x:Name="ResourcesInstalledMode" Style="{StaticResource FilterRadio}" GroupName="ResourceMode" Content="УСТАНОВЛЕННЫЕ" IsChecked="True" Checked="ResourceMode_Checked"/><RadioButton x:Name="ResourcesCatalogMode" Style="{StaticResource FilterRadio}" GroupName="ResourceMode" Content="КАТАЛОГ" Checked="ResourceMode_Checked"/></StackPanel>
                        </Grid>
                        <!-- ================= НАСТРОЙКИ ================= -->
                        <Grid x:Name="SettingsView" Visibility="Collapsed"
                              Margin="0,22,0,30">
