                                                <TextBlock Grid.Row="1" Text="{Binding DateText}"
                                                           Style="{StaticResource Caps}"
                                                           FontSize="9"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Grid.Row="2" Text="{Binding MetaText}"
                                                           Style="{StaticResource Caps}"
                                                           FontSize="9"
                                                           Margin="0,2,0,0"/>
                                                <UniformGrid Grid.Row="3" Rows="3" Columns="2"
                                                             Margin="0,10,0,0"
                                                             VerticalAlignment="Bottom">
                                                    <controls:PixelButton Content="ПАПКА" Variant="Secondary"
                                                                          IconKind="Folder" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Margin="0,0,3,3"
                                                                          Tag="{Binding}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Открыть папку мира {0}}"
                                                                          Click="OpenWorld_Click"/>
                                                    <controls:PixelButton Content="БЭКАП"
                                                                          Variant="Secondary"
                                                                          IconKind="Backup" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Margin="0,0,0,3"
                                                                          Tag="{Binding}"
                                                                          IsEnabled="{Binding IsValid}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Бэкап мира {0}}"
                                                                          Click="BackupWorld_Click"/>
                                                    <controls:PixelButton Content="ВОССТАНОВИТЬ"
                                                                          Variant="Secondary"
                                                                          IconKind="Download" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Margin="0,0,3,3"
                                                                          Tag="{Binding}"
                                                                          IsEnabled="{Binding IsValid}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Восстановить мир {0}}"
                                                                          Click="RestoreWorld_Click"/>
                                                    <controls:PixelButton Content="ДУБЛИРОВАТЬ"
                                                                          Variant="Secondary"
                                                                          IconKind="Plus" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Margin="0,0,0,3"
                                                                          Tag="{Binding}"
                                                                          IsEnabled="{Binding IsValid}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Дублировать мир {0}}"
                                                                          Click="DuplicateWorld_Click"/>
                                                    <controls:PixelButton Content="ЭКСПОРТ"
                                                                          Variant="Secondary"
                                                                          IconKind="Download" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Margin="0,0,3,0"
                                                                          Tag="{Binding}"
                                                                          IsEnabled="{Binding IsValid}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Экспорт мира {0}}"
                                                                          Click="ExportWorld_Click"/>
                                                    <controls:PixelButton Content="УДАЛИТЬ"
                                                                          Variant="Danger"
                                                                          IconKind="Trash" Height="30"
                                                                          IconSize="10" FontSize="8" Padding="3,0"
                                                                          Tag="{Binding}"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Удалить мир {0}}"
                                                                          Click="DeleteWorld_Click"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoWorldsPageText" Grid.Row="1"
                                       Text="Миров пока нет. Запусти игру и создай первый."
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,40,0,0"/>
                        </Grid>

                            <Grid x:Name="WorldCatalogHost" Margin="0,68,0,20" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,22,0,0"><RadioButton x:Name="WorldMineTab" Style="{StaticResource FilterRadio}" GroupName="WorldMode" Content="МОИ МИРЫ" IsChecked="True" Checked="WorldMode_Checked"/><RadioButton x:Name="WorldCatalogTab" Style="{StaticResource FilterRadio}" GroupName="WorldMode" Content="КАТАЛОГ КАРТ" Checked="WorldMode_Checked"/></StackPanel>
                        </Grid>
                        <!-- ================= ЛОГИ ================= -->
                        <Grid x:Name="LogsView" Visibility="Collapsed"
                              Margin="0,22,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ЛОГИ И КРАШИ"
                                               Style="{StaticResource Display}"
                                               FontSize="34" FontWeight="Black"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="latest.log, crash-reports и лог лаунчера"
                                               Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <controls:PixelButton Content="ОБНОВИТЬ" Variant="Secondary"
                                                          IconKind="Refresh" Height="34"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Click="RefreshLogs_Click"/>
                                    <controls:PixelButton Content="ПАПКА ЛОГОВ" Variant="Secondary"
                                                          IconKind="Folder" Height="34"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Click="OpenLogsFolder_Click"/>
                                    <controls:PixelButton Content="ПАПКА КРАШЕЙ" Variant="Danger"
                                                          IconKind="Crash" Height="34"
                                                          FontSize="10"
                                                          Click="OpenCrashFolder_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="LogTabButton" Style="{StaticResource FilterRadio}"
                                             Content="LATEST.LOG" GroupName="LogTab" Tag="latest" IsChecked="True" Checked="LogTab_Checked"/>
                                <RadioButton x:Name="CrashTabButton" Style="{StaticResource FilterRadio}"
                                             Content="КРАШ-РЕПОРТ" GroupName="LogTab" Tag="crash" Checked="LogTab_Checked"/>
                                <TextBlock x:Name="LogPathText" Style="{StaticResource Caps}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Border x:Name="LogsPanel"
                                        Background="{DynamicResource BgDarkBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="2">
                                    <TextBox x:Name="LogTextBox"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="11"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="10"
                                             Height="420"
                                             MaxHeight="420"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"/>
                                </Border>

                                <Border x:Name="CrashPanel"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="2"
                                        Padding="16"
                                        Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock x:Name="CrashTitleText"
                                                       Text="КРАШ-РЕПОРТ"
                                                       Style="{StaticResource Display}"
                                                       FontSize="22" Foreground="{DynamicResource RedBrush}"/>
                                            <TextBlock x:Name="CrashSummaryText"
                                                       Text="Крашей не найдено."
                                                       FontSize="13" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <Border Height="2" Background="{DynamicResource LineBrush}"
                                                    Margin="0,14,0,12"/>
                                            <TextBlock x:Name="CrashRawText"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ================= СЕРВЕРЫ ================= -->
                        <Grid x:Name="ServersView" Visibility="Collapsed"
                              Margin="0,22,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="СЕРВЕРЫ"
                                               Style="{StaticResource Display}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="servers.dat · статус, игроки, пинг"
                                               Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <controls:PixelButton x:Name="ServersRefreshButton"
                                                          Content="ОБНОВИТЬ" Variant="Secondary"
                                                          IconKind="Refresh" Height="34"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Click="RefreshServers_Click"/>
                                    <controls:PixelButton x:Name="ServersAddButton"
                                                          Content="ДОБАВИТЬ" Variant="Primary"
                                                          IconKind="Plus" Height="34"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Click="AddServer_Click"/>
                                    <controls:PixelButton x:Name="ServersDeleteButton"
                                                          Content="УДАЛИТЬ" Variant="Danger"
                                                          IconKind="Trash" Height="34"
                                                          FontSize="10"
                                                          IsEnabled="False"
                                                          Click="DeleteServer_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="ServerAddPanel" Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource GreenBrush}"
                                    BorderThickness="2"
                                    Padding="12,10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="НОВЫЙ СЕРВЕР"
                                               Style="{StaticResource Caps}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ИМЯ" Style="{StaticResource Caps}"
                                                       FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox x:Name="ServerNameBox"
                                                     Style="{StaticResource PixelTextBox}"
                                                     MaxLength="64"
                                                     AutomationProperties.Name="Имя сервера"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="АДРЕС · HOST[:PORT]"
                                                       Style="{StaticResource Caps}"
                                                       FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox x:Name="ServerAddressBox"
                                                     Style="{StaticResource PixelTextBox}"
                                                     MaxLength="255"
                                                     AutomationProperties.Name="Адрес сервера"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ServerFormError"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource RedBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <controls:PixelButton x:Name="ServerSaveButton"
                                                                  Content="СОХРАНИТЬ"
                                                                  Variant="Primary"
                                                                  IconKind="Check" Height="32"
                                                                  FontSize="10" Margin="0,0,6,0"
                                                                  Click="SaveServer_Click"/>
                                            <controls:PixelButton Content="ОТМЕНА"
                                                                  Variant="Secondary"
                                                                  Height="32" FontSize="10"
                                                                  Click="CancelServer_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="{DynamicResource BgDarkBrush}" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="СЕРВЕР / MOTD"
                                                   Style="{StaticResource Caps}" Margin="12,7,0,7"/>
