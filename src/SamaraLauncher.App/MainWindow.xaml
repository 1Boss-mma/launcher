                                                   Style="{StaticResource Caps}" Margin="0,7,12,7"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="ВХОД"
                                                   Style="{StaticResource Caps}" Margin="0,7,20,7"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer MaxHeight="430"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ServersList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource InstanceCardButton}"
                                                                Tag="{Binding}"
                                                                ToolTip="{Binding Tooltip}"
                                                                AutomationProperties.Name="{Binding AutomationName}"
                                                                Click="ServerItem_Click">
                                                            <Grid Margin="12,9">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="180"/>
                                                                    <ColumnDefinition Width="96"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Width="40" Height="40"
                                                                        Background="{DynamicResource BgDarkBrush}"
                                                                        BorderBrush="{DynamicResource LineBrush}"
                                                                        BorderThickness="2"
                                                                        VerticalAlignment="Center">
                                                                    <controls:PixelIcon Kind="Server"
                                                                                        Width="22" Height="22"
                                                                                        Brush="{Binding StatusBrush}"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Margin="10,0,12,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="Bold" FontSize="14"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Address}"
                                                                               FontFamily="{StaticResource MonoFont}"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0"/>
                                                                    <TextBlock Text="{Binding Motd}"
                                                                               Style="{StaticResource MutedText}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               MaxHeight="30"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right">
                                                                    <StackPanel Orientation="Horizontal"
                                                                                HorizontalAlignment="Right">
                                                                        <Ellipse Width="8" Height="8"
                                                                                 Fill="{Binding StatusBrush}"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding PingText}"
                                                                                   FontFamily="{StaticResource MonoFont}"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{Binding PingBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding VersionText}"
                                                                               Style="{StaticResource Caps}"
                                                                               FontSize="9"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding PlayersText}"
                                                                               FontFamily="{StaticResource MonoFont}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <controls:PixelButton Grid.Column="3"
                                                                                      Content="ИГРАТЬ"
                                                                                      Variant="Primary"
                                                                                      IconKind="Play"
                                                                                      IconSize="12"
                                                                                      Width="86" Height="28"
                                                                                      FontSize="9"
                                                                                      Padding="4,0"
                                                                                      Margin="0,0,8,0"
                                                                                      HorizontalAlignment="Right"
                                                                                      VerticalAlignment="Center"
                                                                                      Tag="{Binding}"
                                                                                      AutomationProperties.AutomationId="QuickJoinServer"
                                                                                      AutomationProperties.Name="{Binding QuickJoinName}"
                                                                                      ToolTip="Запустить игру и подключиться к серверу"
                                                                                      Click="QuickJoinServer_Click"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="NoServersText"
                                                   Text="Серверов пока нет. Добавь адрес — и он появится в игре."
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="20,40"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ServersStatusText" Grid.Row="3"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="2,8,2,0"/>
                        </Grid>

                        <!-- ================= МОЙ СЕРВЕР ================= -->
                        <Grid x:Name="HostView" Visibility="Collapsed"
                              Margin="0,22,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="МОЙ СЕРВЕР"
                                               Style="{StaticResource Display}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
