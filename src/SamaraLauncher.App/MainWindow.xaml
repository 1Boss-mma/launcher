                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <controls:PixelFrame x:Name="ProfileSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <controls:PixelAvatar x:Name="SettingsAvatar"
                                                                      Width="56" Height="56"
                                                                      Username="Player"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="НИК" Style="{StaticResource Caps}" FontSize="9"/>
                                                    <TextBox x:Name="NicknameBox"
                                                             Style="{StaticResource PixelTextBox}"
                                                             TextChanged="NicknameBox_TextChanged"
                                                             Margin="0,3,0,0"/>
                                                    <TextBlock Text="Оффлайн-профиль: UUID считается локально."
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame x:Name="InstanceSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <Grid>
                                                <TextBlock Text="ВЫБРАННАЯ СБОРКА" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                            <WrapPanel Margin="0,0,0,12">
                                                <Button Content="Управление сборками" Style="{StaticResource HomeSelectorButton}" Click="AddInstance_Click"/>
                                                <Button Content="Папка сборки" Style="{StaticResource HomeSelectorButton}" Click="HomeOpenFolder_Click"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="InstanceDiskFreeText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="ПАМЯТЬ" Style="{StaticResource Caps}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="MemoryValueText" Text="6 ГБ"
                                                           Style="{StaticResource Caps}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource GreenHiBrush}"/>
                                            </Grid>
                                            <Slider x:Name="MemorySlider"
                                                    Style="{StaticResource PixelSlider}"
                                                    Minimum="1024" Maximum="16384"
                                                    TickFrequency="512"
                                                    SmallChange="512" LargeChange="1024"
                                                    Value="6144"
                                                    Margin="0,8,0,0"
                                                    ValueChanged="MemorySlider_ValueChanged"/>
                                            <Grid>
                                                <TextBlock Text="1 ГБ" Style="{StaticResource Caps}" FontSize="8"/>
                                                <TextBlock Text="16 ГБ" Style="{StaticResource Caps}" FontSize="8"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="Рекомендуется 6–8 ГБ для 87 модов."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="JAVA" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBox x:Name="JavaPathBox" Style="{StaticResource PixelTextBox}" Margin="0,8,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock Text="auto — найти Java 17 автоматически."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame>
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="ПАПКА ИГРЫ" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GameDirBox" Style="{StaticResource PixelTextBox}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                <controls:PixelButton Grid.Column="1"
                                                                      Content="..."
                                                                      Variant="Secondary"
                                                                      Height="32" Width="38"
                                                                      Margin="6,0,0,0"
                                                                      Click="BrowseGameDir_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </controls:PixelFrame>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <controls:PixelFrame x:Name="PackUpdatesSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="СБОРКА" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="PACK.TOML (URL ИЛИ ЛОКАЛЬНЫЙ ПУТЬ)"
                                                       Style="{StaticResource Caps}" FontSize="9"
                                                       Margin="0,8,0,3"/>
                                            <TextBox x:Name="PackUrlBox" Style="{StaticResource PixelTextBox}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock Text="БЭКАПОВ ХРАНИТЬ"
                                                       Style="{StaticResource Caps}" FontSize="9"
                                                       Margin="0,8,0,3"/>
                                            <TextBox x:Name="BackupRetentionBox"
                                                     Style="{StaticResource PixelTextBox}"
                                                     Width="80" HorizontalAlignment="Left"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <controls:PixelButton Content="ПРОВЕРИТЬ"
                                                                      Variant="Secondary"
                                                                      IconKind="Shield" Height="32"
                                                                      FontSize="9" Padding="9,0"
                                                                      Margin="0,0,6,0"
                                                                      Click="Verify_Click"/>
                                                <controls:PixelButton Content="ОБНОВИТЬ"
                                                                      Variant="Secondary"
                                                                      IconKind="Refresh" Height="32"
                                                                      FontSize="9" Padding="9,0"
                                                                      Click="UpdatePack_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame x:Name="BackupsSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <Grid>
                                                <TextBlock Text="АВТОБЭКАПЫ МИРОВ"
                                                           Style="{StaticResource Caps}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <controls:PixelToggle x:Name="AutoBackupToggle"
                                                                      IsChecked="False"
                                                                      Width="52" Height="22"
                                                                      HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ИНТЕРВАЛ, Ч"
                                                               Style="{StaticResource Caps}" FontSize="9"/>
                                                    <TextBox x:Name="AutoBackupIntervalBox"
                                                             Style="{StaticResource PixelTextBox}"
                                                             Height="30" Padding="8,0"
                                                             Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="ХРАНИТЬ, ШТ"
                                                               Style="{StaticResource Caps}" FontSize="9"/>
                                                    <TextBox x:Name="AutoBackupRetentionBox"
                                                             Style="{StaticResource PixelTextBox}"
                                                             Height="30" Padding="8,0"
                                                             Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="ПАПКА НАЗНАЧЕНИЯ (ПУСТО — ПО УМОЛЧАНИЮ)"
                                                       Style="{StaticResource Caps}" FontSize="9"
                                                       Margin="0,8,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="AutoBackupDirBox"
                                                         Style="{StaticResource PixelTextBox}"
                                                         Height="30" Padding="8,0"
                                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                <controls:PixelButton Grid.Column="1"
                                                                      Content="..."
                                                                      Variant="Secondary"
                                                                      Height="30" Width="38"
                                                                      Margin="6,0,0,0"
                                                                      Click="BrowseAutoBackupDir_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="AutoBackupStatusText"
                                                       Text="Автобэкапы выключены."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>
                                            <controls:PixelButton x:Name="AutoBackupNowButton"
                                                                  Content="СДЕЛАТЬ СЕЙЧАС"
                                                                  Variant="Secondary"
                                                                  IconKind="Backup" Height="32"
                                                                  FontSize="9" Padding="8,0"
                                                                  HorizontalAlignment="Stretch"
                                                                  Margin="0,8,0,0"
                                                                  Click="AutoBackupNow_Click"/>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame x:Name="LauncherUpdatesSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="ОБНОВЛЕНИЕ ЛАУНЧЕРА"
                                                       Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="LauncherUpdateStatus"
                                                       Text="Проверка не выполнялась."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10" Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <controls:PixelButton Content="ПРОВЕРИТЬ"
                                                                      Variant="Secondary"
                                                                      IconKind="Download" Height="32"
                                                                      FontSize="9" Padding="9,0"
                                                                      Margin="0,0,6,0"
                                                                      Click="CheckLauncherUpdate_Click"/>
                                                <controls:PixelButton x:Name="InstallUpdateButton"
                                                                      Content="УСТАНОВИТЬ"
                                                                      Variant="Primary"
                                                                      IconKind="Download" Height="32"
                                                                      FontSize="9" Padding="9,0"
                                                                      IsEnabled="False"
                                                                      Click="InstallLauncherUpdate_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame x:Name="AppearanceSettingsCard" Margin="0,0,0,12">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <RadioButton x:Name="ThemeDay" Style="{StaticResource FilterRadio}" Content="ДЕНЬ" GroupName="Theme" Tag="day" Checked="Theme_Checked"/>
                                                <RadioButton x:Name="ThemeNight" Style="{StaticResource FilterRadio}" Content="НОЧЬ" GroupName="Theme" Tag="night" Checked="Theme_Checked"/>
                                                <RadioButton x:Name="ThemeAuto" Style="{StaticResource FilterRadio}" Content="АВТО" GroupName="Theme" Tag="auto" IsChecked="True" Checked="Theme_Checked"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,10,0,0">
                                                <Grid Margin="0,0,0,7">
                                                    <TextBlock Text="ЧАСТИЦЫ" Style="{StaticResource Caps}" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                    <controls:PixelToggle x:Name="ParticlesToggle"
                                                                          IsChecked="True"
                                                                          HorizontalAlignment="Right"
                                                                          Checked="ParticlesToggle_Changed" Unchecked="ParticlesToggle_Changed"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="ЗАКРЫВАТЬ ПРИ ЗАПУСКЕ"
                                                               Style="{StaticResource Caps}" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                    <controls:PixelToggle x:Name="CloseOnLaunchToggle"
                                                                          IsChecked="False"
                                                                          HorizontalAlignment="Right" Checked="CloseOnLaunch_Changed" Unchecked="CloseOnLaunch_Changed"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </controls:PixelFrame>

                                    <controls:PixelFrame x:Name="AboutSettingsCard">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="О ЛАУНЧЕРЕ" Style="{StaticResource Caps}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="AboutText"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,7,0,0"/>
                                            <Button Style="{StaticResource LinkButton}"
                                                    Content="открыть папку лаунчера"
                                                    FontSize="10" Margin="0,6,0,0"
                                                    Click="OpenLauncherFolder_Click"/>
                                        </StackPanel>
                                    </controls:PixelFrame>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- Boot overlay -->
                <Grid x:Name="BootOverlay" Visibility="Collapsed"
                      Background="{DynamicResource PanelBrush}">
                    <Border Width="560"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource PanelBrush}"/>
                            <StackPanel Grid.Row="1" Margin="26,22">
                                <TextBlock x:Name="BootTitle" Text="ЗАПУСК СБОРКИ"
                                           Style="{StaticResource Display}"
                                           FontSize="28" FontWeight="Black"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="BootStatusText"
                                           Text="Подготовка..."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,5,0,16"/>
                                <controls:PixelProgressBar x:Name="BootProgress"
                                                           Value="0" Height="22"/>
                                <TextBlock x:Name="BootTipText"
                                           Text="Совет: первый запуск дольше обычного — скачиваются библиотеки."
                                           Style="{StaticResource MutedText}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                            HorizontalAlignment="Right">
                                    <controls:PixelButton x:Name="BootBackButton"
                                                          Content="ВЕРНУТЬСЯ"
                                                          Variant="Secondary"
                                                          IconKind="Back" Height="36"
                                                          FontSize="10" Margin="0,0,6,0"
                                                          Visibility="Collapsed"
                                                          Click="BootBack_Click"/>
                                    <controls:PixelButton x:Name="BootCancelButton"
                                                          Content="ОТМЕНА"
                                                          Variant="Danger"
                                                          IconKind="Close" Height="36"
                                                          FontSize="10"
                                                          Click="BootCancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                
            </Grid>
        </Grid>

        <!-- ================= МЕНЕДЖЕР СБОРОК ================= -->
        <Grid x:Name="InstancesOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="{DynamicResource PanelBrush}"
              PreviewKeyDown="InstancesOverlay_PreviewKeyDown">

            <controls:PixelFrame Width="1080" Height="610"
                                 Cut="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <Grid Margin="20,14,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="26"
                                    Background="{DynamicResource GreenBrush}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="СБОРКИ"
                                       Style="{StaticResource Display}"
                                       FontSize="26" FontWeight="Black"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="InstancesCountText"
                                       Style="{StaticResource Caps}"
                                       Margin="12,0,0,2"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <Button x:Name="InstancesCloseButton"
                                Style="{StaticResource IconButton}"
                                Width="32" Height="32"
                                HorizontalAlignment="Right"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть менеджер сборок"
                                Click="InstancesClose_Click">
                            <controls:PixelIcon Kind="Close" Width="16" Height="16"
                                                Brush="{DynamicResource MutedBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Список и детали -->
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.28*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="СПИСОК СБОРОК"
                                           Style="{StaticResource Caps}"/>
                                <TextBlock Text="ДВОЙНОЙ КЛИК — СДЕЛАТЬ АКТИВНОЙ"
                                           Style="{StaticResource Caps}"
                                           FontSize="8"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <ScrollViewer x:Name="InstancesScroll"
                                          Grid.Row="1"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="InstancesItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource InstanceCardButton}"
                                                    Tag="{Binding}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    ToolTip="{Binding Tooltip}"
                                                    Click="InstanceItem_Click"
                                                    MouseDoubleClick="InstanceItem_MouseDoubleClick">
                                                <Grid Margin="10,8,12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40" Height="40"
                                                            Background="{Binding IconBrush}"
                                                            BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="2"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <Border Height="3" VerticalAlignment="Top"
                                                                    Background="{DynamicResource PanelBrush}"/>
                                                            <Border Width="3" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{DynamicResource PanelBrush}"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource Display}"
                                                                   FontSize="15"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding VersionText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="10"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding JavaText}"
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource AquaBrush}"/>
                                                            <TextBlock Text=" · "
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"/>
                                                            <TextBlock Text="{Binding MemoryText}"
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"/>
                                                            <TextBlock Text=" · "
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"/>
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"
                                                                       Foreground="{Binding StatusBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding GameDir}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="9"
                                                                   Opacity="0.7"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource PanelBrush}"
                                                                BorderBrush="{DynamicResource GreenBrush}"
                                                                BorderThickness="1"
                                                                Padding="5,2"
                                                                Visibility="{Binding ActiveVisibility}">
                                                            <TextBlock Text="АКТИВНА"
                                                                       Style="{StaticResource Caps}"
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource GreenHiBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="★ ИЗБРАННОЕ"
                                                                   Style="{StaticResource Caps}"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource GoldBrush}"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding FavoriteVisibility}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Column="1" Width="2"
                                Background="{DynamicResource LineBrush}"/>

                        <Grid Grid.Column="2">
                            <!-- Карточка выбранного инстанса -->
                            <ScrollViewer x:Name="InstanceDetailsPanel"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="ИНСТАНС"
                                               Style="{StaticResource Caps}"/>
                                    <TextBlock x:Name="InstanceDetailName"
                                               Text="—"
                                               Style="{StaticResource Display}"
                                               FontSize="22"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="InstanceDetailActive"
                                                   Style="{StaticResource Caps}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource GreenHiBrush}"/>
                                        <TextBlock x:Name="InstanceDetailFavorite"
                                                   Text="★ ИЗБРАННОЕ"
                                                   Style="{StaticResource Caps}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource GoldBrush}"
                                                   Margin="10,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <controls:PixelSeparator Margin="0,9,0,9"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="ВЕРСИЯ"
                                                   Style="{StaticResource Caps}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="InstanceDetailVersion"
                                                   Grid.Row="0" Grid.Column="1"
                                                   Style="{StaticResource WidgetRowValue}"
                                                   Margin="0,0,0,5"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1" Text="JAVA"
                                                   Style="{StaticResource Caps}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="InstanceDetailJava"
                                                   Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource WidgetRowValue}"
                                                   Margin="0,0,0,5"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2" Text="ПАМЯТЬ"
                                                   Style="{StaticResource Caps}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="InstanceDetailMemory"
                                                   Grid.Row="2" Grid.Column="1"
                                                   Style="{StaticResource WidgetRowValue}"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="3" Text="СБОРКА"
                                                   Style="{StaticResource Caps}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="InstanceDetailInstalled"
                                                   Grid.Row="3" Grid.Column="1"
                                                   Style="{StaticResource WidgetRowValue}"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="4" Text="PACK"
                                                   Style="{StaticResource Caps}"/>
                                        <TextBlock x:Name="InstanceDetailPack"
                                                   Grid.Row="4" Grid.Column="1"
                                                   Style="{StaticResource WidgetRowValue}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <TextBlock Text="ПАПКА ИГРЫ"
                                               Style="{StaticResource Caps}"
                                               Margin="0,12,0,4"/>
                                    <TextBlock x:Name="InstanceDetailPath"
                                               Text="—"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="JAVA-ПУТЬ"
                                               Style="{StaticResource Caps}"
                                               Margin="0,10,0,4"/>
                                    <TextBlock x:Name="InstanceDetailJavaPath"
                                               Text="—"
                                               Style="{StaticResource MutedText}"
                                               FontSize="9"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="InstanceDetailNotes"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Inline-форма действий -->
                            <ScrollViewer x:Name="InstanceFormPanel"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="InstanceFormTitle"
                                               Text="ДЕЙСТВИЕ"
                                               Style="{StaticResource Display}"
                                               FontSize="20"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="InstanceFormDescription"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <StackPanel x:Name="InstanceFormNameBlock" Margin="0,12,0,0">
                                        <TextBlock Text="ИМЯ СБОРКИ"
                                                   Style="{StaticResource Caps}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox x:Name="InstanceFormNameBox"
                                                 Style="{StaticResource PixelTextBox}"
                                                 Height="36"
                                                 MaxLength="64"
                                                 AutomationProperties.Name="Имя сборки"/>
                                    </StackPanel>

                                    <StackPanel x:Name="InstanceFormTemplateBlock" Margin="0,10,0,0">
                                        <TextBlock Text="ШАБЛОН (НЕОБЯЗАТЕЛЬНО)"
                                                   Style="{StaticResource Caps}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="InstanceFormTemplateCombo"
                                                  Style="{StaticResource PixelComboBox}"
                                                  AutomationProperties.Name="Шаблон сборки"/>
                                    </StackPanel>

                                    <StackPanel x:Name="InstanceFormCheckBlock" Margin="0,12,0,0">
                                        <CheckBox x:Name="InstanceFormCheck"
                                                  Style="{StaticResource PixelCheckBox}"
                                                  Content="копировать mods/config"/>
                                    </StackPanel>

                                    <StackPanel x:Name="InstanceJavaBlock"
                                                Visibility="Collapsed"
                                                Margin="0,12,0,0">
                                        <TextBlock Text="НАЙДЕННАЯ JAVA"
                                                   Style="{StaticResource Caps}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="InstanceJavaFound"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="ВЕРСИЯ JAVA"
                                                   Style="{StaticResource Caps}"
                                                   Margin="0,10,0,4"/>
                                        <ComboBox x:Name="InstanceJavaMajorCombo"
                                                  Style="{StaticResource PixelComboBox}"
                                                  AutomationProperties.Name="Версия Java">
                                            <ComboBoxItem Tag="8" Content="Java 8"/>
                                            <ComboBoxItem Tag="17" Content="Java 17"/>
                                            <ComboBoxItem Tag="21" Content="Java 21"/>
                                        </ComboBox>
                                        <controls:PixelProgressBar x:Name="InstanceJavaProgress"
                                                                   Value="0"
                                                                   ShowText="True"
                                                                   Height="18"
                                                                   Margin="0,10,0,0"/>
                                        <TextBlock x:Name="InstanceJavaStatusText"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock x:Name="InstanceFormError"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource RedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <controls:PixelButton x:Name="InstanceFormOkButton"
                                                              Content="СОЗДАТЬ"
                                                              Variant="Primary"
                                                              Height="34"
                                                              FontSize="10"
                                                              Padding="14,0"
                                                              Margin="0,0,6,0"
                                                              Click="InstanceFormOk_Click"/>
                                        <controls:PixelButton x:Name="InstanceFormCancelButton"
                                                              Content="ОТМЕНА"
                                                              Variant="Secondary"
                                                              Height="34"
                                                              FontSize="10"
                                                              Padding="14,0"
                                                              Click="InstanceFormCancel_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Кнопки действий -->
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <controls:PixelButton x:Name="InstanceCreateButton"
                                                  Content="СОЗДАТЬ"
                                                  Variant="Primary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceCreate_Click"/>
                            <controls:PixelButton x:Name="InstanceRenameButton"
                                                  Content="ПЕРЕИМЕНОВАТЬ"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceRename_Click"/>
                            <controls:PixelButton x:Name="InstanceDuplicateButton"
                                                  Content="ДУБЛИРОВАТЬ"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceDuplicate_Click"/>
                            <controls:PixelButton x:Name="InstanceDeleteButton"
                                                  Content="УДАЛИТЬ"
                                                  Variant="Danger"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceDelete_Click"/>
                            <controls:PixelButton x:Name="InstanceImportButton"
                                                  Content="ИМПОРТ"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceImport_Click"/>
                            <controls:PixelButton x:Name="InstanceExportButton"
                                                  Content="ЭКСПОРТ"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceExport_Click"/>
                            <controls:PixelButton x:Name="InstanceJavaButton"
                                                  Content="JAVA"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="9" Padding="10,0"
                                                  Margin="0,0,6,0"
                                                  Click="InstanceJava_Click"/>
                        </StackPanel>

                        <controls:PixelButton x:Name="InstanceSelectButton"
                                              Content="ВЫБРАТЬ"
                                              Variant="Primary"
                                              Height="34" FontSize="10" Padding="14,0"
                                              HorizontalAlignment="Right"
                                              Click="InstanceSelect_Click"/>
                    </Grid>

                    <!-- Статус -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="InstancesStatusText"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,220,0"/>
                        <TextBlock Text="ВЫБОР СБОРКИ МЕНЯЕТ МОДЫ, МИРЫ И НАСТРОЙКИ"
                                   Style="{StaticResource Caps}"
                                   FontSize="8"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </controls:PixelFrame>
        </Grid>

        <!-- ================= ОБНОВЛЕНИЯ МОДОВ ================= -->
        <Grid x:Name="ModUpdatesOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="{DynamicResource PanelBrush}">
            <controls:PixelFrame Width="760" Height="530"
                                 Cut="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <Grid Margin="20,14,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="26"
                                    Background="{DynamicResource GoldBrush}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="ОБНОВЛЕНИЯ МОДОВ"
                                       Style="{StaticResource Display}"
                                       FontSize="25" FontWeight="Black"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="ModUpdatesCloseButton"
                                Style="{StaticResource IconButton}"
                                Width="32" Height="32"
                                HorizontalAlignment="Right"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть обновления модов"
                                Click="ModUpdatesClose_Click">
                            <controls:PixelIcon Kind="Close" Width="16" Height="16"
                                                Brush="{DynamicResource MutedBrush}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,12,0,10"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ModUpdatesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="2"
                                            Padding="10,7"
                                            Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="Bold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ModId}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Changelog}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding VersionsText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource GoldBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PublishedText}"
                                                           Style="{StaticResource Caps}"
                                                           FontSize="8"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ModUpdatesSummaryText"
                                   Text="0 обновлений"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:PixelButton x:Name="ModUpdateAllButton"
                                                  Content="ОБНОВИТЬ ВСЁ"
                                                  Variant="Primary"
                                                  IconKind="Download" Height="34"
                                                  FontSize="10" Padding="12,0"
                                                  Margin="0,0,6,0"
                                                  Click="UpdateAllMods_Click"/>
                            <controls:PixelButton Content="ЗАКРЫТЬ"
                                                  Variant="Secondary"
                                                  Height="34" FontSize="10" Padding="12,0"
                                                  Click="ModUpdatesClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </controls:PixelFrame>
        </Grid>

        <!-- ================= ДЕТАЛИ АНАЛИЗА МОДОВ ================= -->
        <Grid x:Name="ModDetailsOverlay" Grid.Row="1" Visibility="Collapsed"
              Background="Transparent" Margin="24,16,24,24" MaxWidth="1180">
            <Border Background="{DynamicResource BuildSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Анализ модов" FontFamily="Bahnschrift" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ModDetailsInstanceText" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ModDetailsCountText" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ModDetailsCloseButton" Grid.Column="1" Style="{DynamicResource BuildButton}" Width="36" Height="36" Padding="0"
                                VerticalAlignment="Top" ToolTip="Закрыть анализ" AutomationProperties.Name="Закрыть детали анализа" Click="ModDetailsClose_Click">
                            <controls:LauncherIcon Kind="Close" Width="16" Height="16" Stroke="{DynamicResource TextBrush}"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ModDetailsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BuildDetailsBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Text}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- ================= ВЫБОР БЭКАПА МИРА ================= -->
        <Grid x:Name="WorldRestoreOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="{DynamicResource PanelBrush}">
            <controls:PixelFrame Width="760" Height="560"
                                 Cut="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <Grid Margin="20,14,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="26"
                                    Background="{DynamicResource AquaBrush}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="ВОССТАНОВИТЬ МИР"
                                       Style="{StaticResource Display}"
                                       FontSize="25" FontWeight="Black"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="WorldRestoreCloseButton"
                                Style="{StaticResource IconButton}"
                                Width="32" Height="32"
                                HorizontalAlignment="Right"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть выбор бэкапа"
                                Click="WorldRestoreClose_Click">
                            <controls:PixelIcon Kind="Close" Width="16" Height="16"
                                                Brush="{DynamicResource MutedBrush}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <TextBlock x:Name="WorldRestoreTargetText"
                                   Text="ВОССТАНОВЛЕНИЕ"
                                   Style="{StaticResource Caps}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="WorldRestoreCountText"
                                   Text="0"
                                   Style="{StaticResource Caps}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="WorldRestoreList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource InstanceCardButton}"
                                                Tag="{Binding}"
                                                Margin="0,0,0,4"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                ToolTip="{Binding FileName}"
                                                Click="WorldRestorePick_Click">
                                            <Grid Margin="10,6,12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="Bold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding DateText}"
                                                               Style="{StaticResource Caps}"
                                                               FontSize="9"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding SizeText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoRestoreBackupsText"
                                   Text="Бэкапов пока нет. Сделай бэкап мира или выбери zip вручную."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <controls:PixelButton x:Name="WorldRestoreBrowseButton"
                                              Content="ВЫБРАТЬ ФАЙЛ..."
                                              Variant="Secondary"
                                              IconKind="Folder" Height="34"
                                              FontSize="10" Padding="12,0"
                                              Margin="0,0,6,0"
                                              Click="WorldRestoreBrowse_Click"/>
                        <controls:PixelButton Content="ОТМЕНА"
                                              Variant="Secondary"
                                              Height="34" FontSize="10" Padding="12,0"
                                              Click="WorldRestoreClose_Click"/>
                    </StackPanel>
                </Grid>
            </controls:PixelFrame>
        </Grid>

    <StackPanel x:Name="ToastHost" Grid.RowSpan="2" Panel.ZIndex="10000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,96,24,0" IsHitTestVisible="False"/>
    </Grid>
</Window>















