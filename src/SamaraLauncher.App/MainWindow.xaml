<Window x:Class="SamaraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SamaraLauncher.App.Controls"
        Title="Launcher"
        Width="1100"
        Height="680"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize" MinWidth="960" MinHeight="600"
        Background="{DynamicResource PanelBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HomeSelectorButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="4"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Panel2Brush}"/></Trigger>
            <Trigger Property="Tag" Value="Open"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Panel2Brush}"/></Trigger>
            
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Panel2Brush}"/><Setter TargetName="ButtonContent" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="HomeBuildSelectorButton" TargetType="Button" BasedOn="{StaticResource HomeSelectorButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusFrame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="BuildContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Panel2Brush}"/></Trigger>
                            <Trigger Property="Tag" Value="Open"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Panel2Brush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter TargetName="BuildContent" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="FocusFrame" Property="Background" Value="{DynamicResource Panel2Brush}"/><Setter TargetName="BuildContent" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetRowValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Карточка сборки в менеджере инстансов -->
        <Style x:Key="InstanceCardButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Card"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{Binding FrameBrush}"
                                BorderThickness="2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding BarBrush}"/>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Чекбокс -->
        <Style x:Key="PixelCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    Background="{DynamicResource BgDarkBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph"
                                           Text="✓"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GreenHiBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Выпадающий список -->
        <Style x:Key="PixelComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GreenLoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PixelComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PixelComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Text="▾"
                                                   Style="{StaticResource Caps}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None"
                                   StaysOpen="False">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="210"
                                        Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TITLEBAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgDarkBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,2"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="26" Height="26"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="2"
                        VerticalAlignment="Center">
                    <controls:PixelBlock Width="20" Height="20"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Launcher"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TitleVersionText"
                               Style="{StaticResource Caps}" Margin="8,0,0,1"
                               VerticalAlignment="Bottom"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}"
                             Margin="0,0,7,0"/>
                    <TextBlock x:Name="TitleChannelText"
                               Text="Основной канал · обновлений нет"
                               Style="{StaticResource Caps}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" Content="◐"
                            FontSize="15" ToolTip="День / ночь"
                            Click="ThemeButton_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="—"
                            ToolTip="Свернуть" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowCloseButton}" Content="✕"
                            ToolTip="Закрыть" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левый рейл -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,2,0">
                <Grid Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="МЕНЮ" Style="{StaticResource Caps}" Margin="12,0,0,8"/>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" IsChecked="True" Tag="home"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Home" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Главная" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavMods" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="mods" Checked="Nav_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:PixelIcon Kind="Mods" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Grid.Column="1" Text="Моды" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="2" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="NavModsCount" Text="0"
                                               Style="{StaticResource Caps}" FontSize="9"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavWorlds" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="worlds" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Worlds" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Миры" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="logs" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Logs" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Логи" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavServers" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="servers" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Server" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Серверы" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHost" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="host" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Server" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Мой сервер" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDoctor" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="doctor" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Shield" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Диагностика" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavResources" Visibility="Collapsed" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="resources" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Folder" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Ресурсы" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}"
                                     GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelIcon Kind="Settings" Width="17" Height="17"
                                                    Brush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Настройки" Margin="12,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="2" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <controls:PixelAvatar x:Name="NavAvatar" Width="40" Height="40"
                                                      Username="Player"
                                                      Cursor="Hand"
                                                      ToolTip="Изменить ник"
                                                      MouseLeftButtonDown="NickEditStart_MouseLeftButtonDown"/>
                                <Grid Margin="9,0,0,0" MinHeight="26" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavNickText" Text="Player"
                                               FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               ToolTip="Изменить ник"
                                               MouseLeftButtonDown="NickEditStart_MouseLeftButtonDown"/>
                                    <TextBox x:Name="NavNickEdit"
                                             Style="{StaticResource PixelTextBox}"
                                             FontSize="12" FontWeight="Bold"
                                             Height="26" MinWidth="80" Padding="6,0"
                                             MaxLength="16"
                                             Visibility="Collapsed"
                                             KeyDown="NavNickEdit_KeyDown"
                                             LostKeyboardFocus="NavNickEdit_LostKeyboardFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Сцена -->
            <Grid Grid.Column="1">
                <controls:PixelPanorama x:Name="Panorama"
                                        IsNight="False"
                                        AnimationEnabled="True"
                                        ParticlesEnabled="True"
                                        ClipToBounds="True"/>
                <Border x:Name="SceneCover" IsHitTestVisible="False"/>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000A0C0F" Offset="0"/>
                            <GradientStop Color="#4A0A0C0F" Offset="0.55"/>
                            <GradientStop Color="#D80A0C0F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ScrollViewer x:Name="PageScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <Grid Margin="26,0,26,0" MaxWidth="1180">
                        <!-- ================= ГЛАВНАЯ ================= -->
                        <Grid x:Name="HomeView" MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
                            <Border MaxWidth="850" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,24,0,28"
                                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18,15">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="174"/></Grid.ColumnDefinitions>
                                        <Button x:Name="HomeBuildButton" Style="{StaticResource HomeBuildSelectorButton}" Click="HomeBuild_Click"
                                                AutomationProperties.Name="Выбрать сборку или установить версию" HorizontalContentAlignment="Stretch" Margin="0,0,18,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                <controls:PixelBlock Width="36" Height="36" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                                    <TextBlock x:Name="SelectedInstanceName" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <TextBlock x:Name="SelectedInstanceMeta" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel><TextBlock x:Name="HomeBuildArrow" Grid.Column="2" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=HomeBuildButton}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="22"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            </Grid>
                                        </Button>
                                        <controls:PixelButton x:Name="PlayButton" Grid.Column="1" Flat="True" Content="Играть" IconKind="Play" Height="50" FontSize="17" Click="Play_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="HomeOperationStrip" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Height="1" Background="{DynamicResource PanelBrush}" Margin="0,0,0,10"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" MaxHeight="60" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"/>
