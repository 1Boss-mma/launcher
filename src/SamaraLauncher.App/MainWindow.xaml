                                               Margin="16,0,12,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="ЛОКАЛЬНЫЙ ХОСТИНГ"
                                               Style="{StaticResource Caps}"
                                               FontSize="9"
                                               VerticalAlignment="Center"/>
