                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="НАСТРОЙКИ"
                                               Style="{StaticResource Display}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Профиль, память, сборка и обновления"
                                               Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <controls:PixelButton x:Name="SaveSettingsButton"
                                                      Content="СОХРАНИТЬ" Variant="Primary"
                                                      IconKind="Check" Height="38"
                                                      FontSize="11" Width="150"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Click="SaveSettings_Click"/>
